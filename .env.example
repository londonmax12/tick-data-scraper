# Quant Data — Download Manager configuration.
#
# Copy this file to ".env" and fill in what you need:
#     cp .env.example .env          # macOS/Linux
#     Copy-Item .env.example .env   # PowerShell
#
# The real ".env" is git-ignored, so secrets never get committed. Every value
# below is OPTIONAL and has a built-in default — the app runs with no .env at
# all. Blank or invalid numeric values fall back to the default automatically.

# --- FRED (Federal Reserve Economic Data) ----------------------------------
# Required for FRED jobs only. Get a free key (instant) at:
#   https://fred.stlouisfed.org/docs/api/api_key.html
# Without it, FRED jobs fail with a clear message; all other sources still work.
FRED_API_KEY=
# Max FRED requests/second across all workers (FRED's ceiling is 120/min = 2/s).
FRED_RATE_LIMIT=2
# Contact User-Agent sent on FRED requests.
FRED_UA=quant_data/1.0 (you@example.com)

# --- SEC EDGAR -------------------------------------------------------------
# SEC requires a descriptive User-Agent with a contact address on every request
# (anonymous ones get a 403). Set your own contact here.
SEC_UA=quant_data/1.0 (you@example.com)
# Max SEC requests/second across all workers (SEC's ceiling is 10).
SEC_RATE_LIMIT=8

# --- CFTC Commitments of Traders -------------------------------------------
# Keyless. The CFTC's Socrata host throttles anonymous traffic; an optional free
# app token lifts the ceiling. Get one at:
#   https://publicreporting.cftc.gov/profile/app_tokens
# Leave blank to run anonymously (fine for small pulls).
CFTC_APP_TOKEN=
# Max CFTC requests/second across all workers.
CFTC_RATE_LIMIT=5
# Contact User-Agent sent on CFTC requests.
CFTC_UA=quant_data/1.0 (you@example.com)

# --- Binance futures (USD-M / COIN-M derivatives) --------------------------
# Keyless. The public market-data endpoints (klines, funding, open interest,
# long/short sentiment, taker flow) enforce a per-IP request-weight budget and
# auto-ban (HTTP 418) IPs that ignore 429s, so all futures traffic funnels
# through a shared limiter kept to a polite few requests/second.
BINANCE_FUTURES_RATE_LIMIT=10

# --- Download manager (applies to every source) ----------------------------
# Max download tasks running at once across the whole manager.
DM_CONCURRENCY=12
# Per-request network timeout, in seconds.
DM_TIMEOUT=30
# Retries (with exponential backoff) before a task is marked permanently failed.
DM_MAX_ATTEMPTS=50
